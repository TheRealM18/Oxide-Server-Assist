<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\7 Days To Die</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\PackPaths.cs" Link="PackPaths.cs" />
    <Compile Include="..\..\src\PackLogger.cs" Link="PackLogger.cs" />
    <Compile Include="..\..\src\PackConfig.cs" Link="PackConfig.cs" />
    <Compile Include="..\..\src\PackUrls.cs" Link="PackUrls.cs" />
    <Compile Include="..\..\src\PackDownloadResolver.cs" Link="PackDownloadResolver.cs" />
    <Compile Include="..\..\src\PackManifest.cs" Link="PackManifest.cs" />
    <Compile Include="..\..\src\PackProfile.cs" Link="PackProfile.cs" />
    <Compile Include="..\..\src\PackState.cs" Link="PackState.cs" />
    <Compile Include="..\..\src\PackPending.cs" Link="PackPending.cs" />
    <Compile Include="..\..\src\PackSignature.cs" Link="PackSignature.cs" />
    <Compile Include="..\..\src\PackInstaller.cs" Link="PackInstaller.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
</Project>
