<?xml version="1.0" encoding="utf-8"?>
<PackBootstrap>
  <!--
    Single-pack manifest URL. Leave empty when using PackIndexUrl below.
    For a single static pack, put its manifest URL here instead.
  -->
  <ManifestUrl></ManifestUrl>

  <!-- Optional signature URL. Defaults to ManifestUrl + ".sig" when possible. -->
  <SignatureUrl></SignatureUrl>

  <!-- Optional CDN/API token. Leave empty for a public static CDN. -->
  <AccessToken></AccessToken>

  <!--
    Paste the contents of public-key.xml here (the RSAKeyValue XML).
    Leave empty to allow unsigned manifests; the UI will warn the player.
    Set RequireSignature to true once you have generated a key.
  -->
  <PublicKeyXml><![CDATA[]]></PublicKeyXml>
  <RequireSignature>false</RequireSignature>

  <!--
    Empty allows any host. For the current CDN, set this to 147.5.123.159.
  -->
  <AllowedHosts></AllowedHosts>

  <!--
    true for a plain HTTP self-hosted CDN. Use HTTPS when available.
  -->
  <AllowInsecureHttp>true</AllowInsecureHttp>

  <CheckOnMainMenu>true</CheckOnMainMenu>

  <!--
    Show a "Mod Packs" button on the main menu. It reopens the pack window.
  -->
  <ShowMainMenuButton>true</ShowMainMenuButton>

  <ShowCheckErrors>true</ShowCheckErrors>

  <!--
    Optional remote pack index. It must return JSON:
      { "packs": [
          { "id": "qln", "name": "QLN Server",
            "manifestUrl": "https://...", "gameVersion": "3.4" }
      ] }
    Local <Packs> entries win over remote entries with the same id.
  -->
  <PackIndexUrl></PackIndexUrl>

  <!--
    Pack selected on first run. Leave empty to use the first local pack,
    or Vanilla when no packs are configured.
  -->
  <DefaultPackId></DefaultPackId>
  <DefaultPackName>QLN Server</DefaultPackName>

  <!--
    Optional local pack list. If omitted, ManifestUrl above becomes the
    default pack and Vanilla is added automatically.

    <Packs>
      <Pack>
        <Id>mod-main</Id>
        <Name>Main Server</Name>
        <ManifestUrl>http://147.5.123.159:8080/mod-main/manifest.json</ManifestUrl>
        <GameVersion>3.4</GameVersion>
      </Pack>
    </Packs>
  -->

  <KeepBackups>3</KeepBackups>
  <MaxModBytes>2147483648</MaxModBytes>
  <MaxTotalBytes>8589934592</MaxTotalBytes>
  <MaxEntries>100000</MaxEntries>
  <MaxUncompressedBytes>8589934592</MaxUncompressedBytes>

  <!-- Remove pack-owned mods that are no longer listed in the manifest. -->
  <RemoveObsolete>false</RemoveObsolete>

  <!-- Shown in the UI and used for a warning only. -->
  <GameVersion>3.4</GameVersion>

  <!-- Optional. Leave empty to use <game folder>\7DaysToDie.exe. -->
  <GameExe></GameExe>

  <!-- Relaunch the game after the updater applies the pack. -->
  <AutoRelaunch>true</AutoRelaunch>

  <!--
    When true, the client restarts automatically a few seconds after all mods
    are downloaded and staged. The updater applies the pack and relaunches.
  -->
  <AutoRestart>true</AutoRestart>

  <!--
    How many mods to download at the same time. Allowed range: 1-10.
    Self-hosted/CDN servers can usually handle 10. Google Drive often
    throttles above 3-4, so lower it if you still use Drive.
  -->
  <MaxParallelDownloads>10</MaxParallelDownloads>

  <!--
    Install target. Empty means "the folder that contains this bootstrap mod
    folder", i.e. the active Mods directory the bootstrap was loaded from.
    Set an absolute path (or a path relative to this bootstrap folder) only if
    you need to force a different active Mods directory.
  -->
  <ModsRoot></ModsRoot>
</PackBootstrap>
